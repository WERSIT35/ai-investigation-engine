# ---- Vector DB (Qdrant Cloud free tier: https://cloud.qdrant.io) ----
# Leave QDRANT_URL empty to use a local on-disk Qdrant at QDRANT_PATH (dev only).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./qdrant_data
COLLECTION=docs

# ---- Embeddings ----
EMBED_BACKEND=fastembed
EMBED_MODEL=BAAI/bge-small-en-v1.5

# ---- LLM: any OpenAI-compatible endpoint ----
# Gemini (free tier, AI Studio key):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
# Groq alternative:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# ---- Retrieval / chunking ----
CHUNK_STRATEGY=recursive
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=8
CANDIDATE_POOL=50
RRF_K=60
MAX_CHUNKS_PER_DOC=2
MAX_AGENT_STEPS=4

# ---- Public demo protection ----
# Set ADMIN_TOKEN so only you can upload/delete on the live demo.
ADMIN_TOKEN=
ASK_RATE_PER_MIN=10
MAX_UPLOAD_MB=10
